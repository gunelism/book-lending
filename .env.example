# Copy this file to .env and fill in real values.  .env is git-ignored.
# Generate random secrets with:  openssl rand -base64 48

# ---------- PostgreSQL ----------
# In production point DATABASE_URL at a managed provider (Neon, Supabase, RDS…).
POSTGRES_USER=library
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=library

# ---------- Object storage (S3-compatible) ----------
# Locally this is MinIO; in production use AWS S3, Cloudflare R2, etc.
S3_ACCESS_KEY=change-me-minio-user
S3_SECRET_KEY=change-me-minio-password-min-8
S3_BUCKET=library-covers
S3_REGION=us-east-1

# ---------- App secrets ----------
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CSRF_SECRET=change-me-to-another-long-random-string-32-chars

# ---------- Seed users (used only by the seed script) ----------
SEED_ADMIN_EMAIL=admin@library.local
SEED_ADMIN_PASSWORD=change-me-Admin-123
SEED_STAFF_PASSWORD=change-me-Staff-123

# ---------- GitHub OAuth (optional) ----------
# Create an OAuth app at https://github.com/settings/developers
# Callback URL: https://localhost/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
