# Copy this file to .env and fill in real values.  .env is git-ignored.
# Generate random secrets with:  openssl rand -base64 48

# =====================================================================
#  Where the data lives
# =====================================================================
# Option A (default, local development): run Postgres + S3-compatible storage
# as local containers. Remove this line when you use managed services (Option B).
COMPOSE_PROFILES=local-services

# Every secret below is EMPTY on purpose: never commit real values, and never run with example ones.
# Generate each one with:   openssl rand -base64 48 | tr -d '/+=\n'
# The API refuses to start (and the seed to run) while a secret is missing or too short.

# Local container credentials (used by Option A only)
POSTGRES_USER=library
POSTGRES_PASSWORD=
POSTGRES_DB=library

# ---------- Database ----------
# Option A: leave DATABASE_URL commented out; the local container is used.
# Option B: Neon. The project is linked in neon.ts / .neon; `npx neon@latest deploy`
#   (or `npx neon@latest env pull`) writes these two lines here for you:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#   The pooled DATABASE_URL serves the app; the direct _UNPOOLED one runs migrations and the seed.
#   sslmode=require turns TLS on by itself. Other providers: set DATABASE_URL (+ DATABASE_SSL=true if the URL has no sslmode).

# ---------- Object storage (S3-compatible) — book covers ----------
# The API picks ONE source, first match wins:
#  1. Neon Object Storage (recommended with Neon): the bucket is declared in neon.ts, and
#     `npx neon@latest deploy` writes these four lines here for you. Nothing else to set.
# AWS_ENDPOINT_URL_S3=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
#  2. Any other S3-compatible store (AWS S3, Cloudflare R2…): set S3_ENDPOINT and the S3_* keys;
#     it then takes precedence over Neon.
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false
#  3. Neither: the local storage container (COMPOSE_PROFILES=local-services). Its root
#     credentials are these two; set S3_SECRET_KEY to a random value.
S3_ACCESS_KEY=library
S3_SECRET_KEY=
# Bucket name, for every source (must match the bucket in neon.ts).
S3_BUCKET=library-covers
S3_REGION=us-east-1

# =====================================================================
#  App
# =====================================================================
# 32+ random characters each, different from each other.
SESSION_SECRET=
CSRF_SECRET=

# Public address. Local: leave as is. Deployed: your domain + an email for Let's Encrypt.
# SITE_ADDRESS=library.example.com
# CADDY_TLS=you@example.com
# PUBLIC_URL=https://library.example.com

# ---------- Help chat (the "Help" button on every admin page) ----------
# Any OpenAI-compatible provider. Default: Groq's free tier (no credit card):
#   create a key at https://console.groq.com/keys and paste it below.
# Leave AI_API_KEY empty to run without the chat; the panel then says it is turned off.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
# Sent as reasoning_effort (low/medium/high) for reasoning models; leave empty if a provider rejects it.
AI_REASONING_EFFORT=low
# Alternatives (only these 3 lines change):
#   Google Gemini free tier (key from https://aistudio.google.com/apikey):
#     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     AI_MODEL=gemini-2.5-flash
# Providers retire models: if the chat says "model not available", pick a current one
# from the provider's model list (Groq: https://console.groq.com/docs/models).
#   Self-hosted Ollama on your machine (no account; any non-empty key):
#     AI_BASE_URL=http://host.docker.internal:11434/v1
#     AI_MODEL=llama3.2:3b
#     AI_API_KEY=ollama
#     AI_REASONING_EFFORT=

# ---------- Seed users (used only by the seed script) ----------
# Passwords of the seeded admin and librarian accounts: 12+ characters, choose your own.
# They are set when the seed runs; changing them later needs a re-seed or Staff → edit.
SEED_ADMIN_EMAIL=admin@library.local
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

# ---------- GitHub OAuth (optional) ----------
# Create an OAuth app at https://github.com/settings/developers
# Callback URL: https://localhost/auth/github/callback  (or https://<your domain>/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Logging ----------
# LOG_LEVEL: error | warn | log (default: one line per request) | debug (also health checks)
# LOG_FORMAT: pretty (default, for `docker compose logs`) | json (one object per line, for log services)
LOG_LEVEL=log
LOG_FORMAT=pretty
