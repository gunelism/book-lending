{
  "name": "@library/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate:deploy": "node dist/database/run-migrations.js",
    "seed": "node dist/seed/seed.js",
    "seed:dev": "ts-node --transpile-only src/seed/seed.ts",
    "db:reset": "node dist/seed/seed.js --reset",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.10",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/throttler": "^6.4.0",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.1.0",
    "dataloader": "^2.2.3",
    "express-session": "^1.18.2",
    "graphql": "^16.11.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "typeorm": "^0.3.27",
    "@nestjs/typeorm": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.2.10",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}